{
  "name": "capitulo-ii",
  "private": true,
  "version": "0.1.0",
  "description": "CAPÍTULO II — aventura narrativa en pixel art basada libremente en 1984",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "art": "python3 art/exportar.py"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "inkjs": "^2.4.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
